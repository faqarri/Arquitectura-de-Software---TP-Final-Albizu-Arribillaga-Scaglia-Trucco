# Copiar a .env y completar. .env NO se versiona.
MYSQL_ROOT_PASSWORD=cambiar
RABBITMQ_USER=agencia
RABBITMQ_PASSWORD=cambiar
# Generar con: openssl rand -hex 32. Nunca usar un secreto conocido del repositorio.
JWT_SECRET=

# Puerto de MySQL en tu máquina. Si ya tenés un MySQL instalado usando el 3306, poné otro (por ejemplo 3307).
MYSQL_PUERTO=3306

# Un usuario de MySQL por servicio, con acceso solo a su esquema (ADR-003).
CATALOGO_DB_PASSWORD=cambiar
RESERVAS_DB_PASSWORD=cambiar
COMPROBANTES_DB_PASSWORD=cambiar
USUARIOS_DB_PASSWORD=cambiar

# Administrador inicial para la demo. Definir ambos; la contraseña no se versiona.
USUARIOS_ADMIN_EMAIL=
USUARIOS_ADMIN_PASSWORD=

# Usuario de solo lectura de Grafana, limitado a las tablas app_logs.
GRAFANA_DB_PASSWORD=cambiar

# API Keys de los grupos consumidores de la API de Comprobantes: grupo:clave,grupo:clave
COMPROBANTES_API_KEYS=grupo-ejemplo:cambiar

# Activar solo para pruebas locales de errores HTTP 5xx y logs.
HABILITAR_ENDPOINT_ERROR_PRUEBA=false

# Correo de Comprobantes: cuenta compartida del grupo. SMTP_PASSWORD es la contraseña
# de aplicación de esa cuenta: pedirla al grupo, nunca versionarla.
# Para usar Mailpit local (http://localhost:8025) en lugar de Gmail, dejar las cinco vacías.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=algoritmostrabajojeje@gmail.com
SMTP_PASSWORD=cambiar
SMTP_REMITENTE=algoritmostrabajojeje@gmail.com

# Retención de cupos en Catálogo (ADR-014). No son secretos: valores por defecto.
RETENCION_MINUTOS=15
RETENCION_MAX_CUPOS_POR_OFERTA=6
RETENCION_BARRIDO_SEGUNDOS=15

# Caché Redis del detalle de ofertas (ADR-007). false para medir sin caché.
CACHE_HABILITADA=true

# Estudiario (Grupo 2): capacidad de guías que consumen Reservas y Catálogo (ADR-009).
# Sin ESTUDIARIO_URL se usa el mock de su contrato (estudiario-mock). La API Key
# la entregan por privado: va acá en tu .env, nunca en el repositorio.
ESTUDIARIO_URL=
ESTUDIARIO_API_KEY=

# Gateway: 120 solicitudes/minuto por usuario autenticado o IP pública (ráfaga de hasta 20).
GATEWAY_RATE_LIMIT_POR_MINUTO=120
# URLs internas separadas por coma (servicios catalogo-1 y catalogo-2 de Compose).
GATEWAY_CATALOGO_INSTANCIAS=http://catalogo-1:8080,http://catalogo-2:8080
TIEMPO_REAL_URL=

# Frontend: con datos de demostración hasta que estén listas las rutas de búsqueda.
# Para probar Usuarios/Reservas a través del gateway: FRONTEND_DATOS_FALSOS=false y reconstruir.
FRONTEND_DATOS_FALSOS=true
FRONTEND_GATEWAY_URL=http://gateway:8080
