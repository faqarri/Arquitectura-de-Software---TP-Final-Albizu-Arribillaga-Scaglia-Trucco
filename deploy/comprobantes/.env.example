# Copiar a .env EN EL SERVIDOR y completar. .env NO se versiona.
# Usar contraseñas distintas a las del entorno local.

# Nombre DNS de la VM. Sin dominio propio: la IP con guiones + .sslip.io
# (ejemplo: IP 203.0.113.10 -> 203-0-113-10.sslip.io).
DOMINIO=cambiar.sslip.io

MYSQL_ROOT_PASSWORD=cambiar
COMPROBANTES_DB_PASSWORD=cambiar
RABBITMQ_USER=agencia
RABBITMQ_PASSWORD=cambiar

# Correo real (cuenta compartida del grupo). SMTP_PASSWORD es la contraseña de
# aplicación de Gmail: pedirla al grupo, nunca versionarla.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=algoritmostrabajojeje@gmail.com
SMTP_PASSWORD=cambiar
SMTP_REMITENTE=algoritmostrabajojeje@gmail.com

# Opcional: claves fijas grupo:clave,grupo:clave (las normales se piden con POST /v1/api-keys).
COMPROBANTES_API_KEYS=
